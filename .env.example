# Gemini API key (https://aistudio.google.com/apikey) - used for the (still-free)
# room-description text call, tier notes, and the dormant image-gen path ONLY.
# NOT used for materials/pricing (see the 3 dedicated keys below) - keeping this
# one reserved means the room-description call, which runs on every project
# regardless of city, never competes for quota with materials lookups. Free-tier
# image generation was removed by Google in Dec 2025 - image generation now uses
# OpenAI below.
GEMINI_API_KEY=
# gemini-2.5-flash 404s ("no longer available to new users") on accounts created
# after Google restricted it - confirmed via a real API call, not theoretical.
# gemini-3.5-flash and gemini-flash-latest both confirmed working.
GEMINI_TEXT_MODEL=gemini-3.5-flash

# Materials/pricing feature: one DEDICATED Gemini key per tier (separate Google
# accounts/projects), so each tier's materials-synthesis call runs on its own
# rate-limit quota with zero contention between tiers or with GEMINI_API_KEY
# above. A tier with no dedicated key falls back to GEMINI_API_KEY (see
# Settings.gemini_materials_api_keys in app/config.py).
GEMINI_MATERIALS_API_KEY_ECONOMICAL=
GEMINI_MATERIALS_API_KEY_MID=
GEMINI_MATERIALS_API_KEY_PREMIUM=

# SerpApi (https://serpapi.com/manage-api-key) - real Google search results for
# materials pricing. Free plan: 250 searches/month, no card required. Used
# instead of Gemini's own Google Search grounding tool, which hit a 429
# RESOURCE_EXHAUSTED wall on every Gemini key/project tested here (a live,
# reproducible failure, not theoretical - see app/providers/gemini.py). Not
# per-tier like the Gemini materials keys above (SerpApi's rate limit isn't
# tier-scoped) - SERPAPI_API_KEY_2 is instead an optional FALLBACK account:
# app/providers/serpapi.py automatically switches to it the moment the first
# key's monthly quota runs out mid-generation, instead of every search
# failing for the rest of the month. Leave it blank for single-key behavior.
SERPAPI_API_KEY=
SERPAPI_API_KEY_2=

# Pixazo (https://www.pixazo.ai) - abandoned: their API gateway blocks server-side
# requests with a Cloudflare bot challenge (403), unusable for backend integration.
PIXAZO_API_KEY=

# NVIDIA NIM (https://build.nvidia.com/qwen/qwen-image-edit) - experimental alternate
# image provider, Qwen-Image-Edit: real instruction-based editing (not img2img+
# strength), open-weight, comparable structure-preservation to closed-source models.
# Hosted via https://integrate.api.nvidia.com. Never wired into get_provider().
NVIDIA_API_KEY=

# OpenAI Images API (https://platform.openai.com/api-keys) - the image generation
# backend (paid). A free Cloudflare Workers AI/SD1.5 fallback existed earlier and
# was removed entirely once OpenAI became the real backend.
# COST WARNING: `quality` alone does NOT control cost - `input_fidelity` is a
# SEPARATE param that also drives cost heavily and defaults to "high" (expensive)
# if omitted. A real test call with only quality=low set cost $0.10/image, ~20x
# the expected ~$0.005 "low quality" figure quoted in pricing articles (which
# describe generation cost, not edit/image-input cost). Set both to "low" for
# cheap tuning. input_fidelity also isn't purely a cost knob - OpenAI describes
# it as controlling "fidelity to the original input image(s)" (i.e. structure
# preservation) - if renders drift structurally, try "high" here first.
# MODEL: gpt-image-1, not gpt-image-2 - gpt-image-2 rejects input_fidelity
# outright (400 error), so it can't do a cheap-input-processing tier at all.
# gpt-image-1 retires Oct 2026; deliberate choice anyway, not an oversight.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_INPUT_FIDELITY=low

# "Build a House" render fidelity - separate from OPENAI_IMAGE_INPUT_FIDELITY
# above (which the room-redesign Economical tier also reads), so this can be
# raised without touching Economical's cost/fidelity.
OPENAI_HOUSE_INPUT_FIDELITY=high

# "Build a House" render quality - separate from OPENAI_IMAGE_QUALITY (the room
# tiers' "low"). Only 1-2 renders/generation for this feature, so "high" is
# affordable and worth it for a genuinely good picture.
OPENAI_HOUSE_IMAGE_QUALITY=high

# Room-redesign image backend toggle: "modal" (default - self-hosted, see
# app/providers/modal_provider.py), "openai", or "kaggle" (kept dormant, not
# deleted, in case Modal ever needs a fallback - see app/providers/kaggle.py).
# Modal replaced Kaggle as the default because Kaggle's phone-verification
# step for a second account rejected every number tried (confirmed regional -
# Pakistan/+92 is missing entirely from several platforms' SMS-OTP country
# dropdowns); Modal's signup is GitHub/Google OAuth only, no phone step.
IMAGE_PROVIDER=modal

# Modal room-redesign endpoints (app/providers/modal_provider.py) - permanent
# URLs printed once by `modal deploy modal_room_redesign.py` (see that file
# in the project's scratch history). Unlike Kaggle's tunnel URL, these don't
# rotate on their own.
MODAL_ROOM_REDESIGN_URL=
MODAL_ROOM_REDESIGN_BATCH_URL=
# Same speed/quality middle ground validated on Kaggle - same underlying
# model + GPU class (T4), so the same numbers apply.
MODAL_NUM_INFERENCE_STEPS=20
MODAL_BATCH_RESOLUTION=768

# "Build a House" render backend toggle: "modal" (default - self-hosted, same
# stack as room-redesign, see modal_house_generation.py) or "openai"
# (gpt-image-1, the original backend - kept as a fallback toggle). Separate
# from IMAGE_PROVIDER above so switching one never silently affects the other.
HOUSE_IMAGE_PROVIDER=modal
MODAL_HOUSE_URL=

# Kaggle room-redesign endpoint - DORMANT unless IMAGE_PROVIDER=kaggle above.
# A Cloudflare quick-tunnel URL pointing at a live Kaggle notebook session -
# ephemeral, expect to update it on every restart if this path is ever used
# again.
KAGGLE_API_URL=
# Diffusion steps sent to the Kaggle endpoint (its own default is 30). 20 is
# the accepted speed/quality middle ground from a real side-by-side test.
KAGGLE_NUM_INFERENCE_STEPS=20
# Resolution for the 3-tier /generate_batch call only (single-image /generate
# stays at 1024). A real batch-of-3 test OOM'd during VAE decode at 1024x1024
# even with attention/VAE slicing enabled - 768 cuts compute + peak VRAM
# meaningfully (~44% fewer pixels).
KAGGLE_BATCH_RESOLUTION=768

# Storage backend: "local" (default, dev) or "s3" (Cloudflare R2 / AWS S3, S3-compatible)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/storage

# Only needed when STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# SQLite database file
DATABASE_URL=sqlite:///data/app.db

# Clerk (https://clerk.com) - the entire auth system (signup, login, Google
# sign-in, session issuance) as of the Clerk migration. Get both from the
# Clerk Dashboard > API keys. CLERK_PUBLISHABLE_KEY is also hardcoded
# directly into static/clerk-init.js (it's meant to be public, safe to
# expose) - update it there too if you switch Clerk instances/apps.
# CLERK_SECRET_KEY is backend-only, used by app/auth.py to verify the
# session JWT a Clerk-authenticated frontend sends.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set ONLY when the frontend (static/) is deployed to a DIFFERENT domain than
# this backend - e.g. frontend on Vercel, this FastAPI app on Render. Enables
# CORS for exactly this origin and switches the session cookie to
# SameSite=None+Secure (required for any cross-site cookie to survive at
# all). Leave blank for local dev or a single-service deploy where this
# backend serves its own static/ (e.g. the render.yaml blueprint as-is) -
# both already work with zero config. Full origin, no trailing slash, e.g.
# https://your-app.vercel.app
FRONTEND_ORIGIN=
