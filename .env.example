# Gemini API key (https://aistudio.google.com/apikey) - used for the (still-free)
# room-description text call only. Free-tier image generation was removed by
# Google in Dec 2025 - image generation now uses Cloudflare Workers AI below.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Cloudflare Workers AI (https://dash.cloudflare.com -> Workers AI -> Use REST API)
# free tier: 10,000 neurons/day, no card required. Used for image generation.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img

# Pixazo (https://www.pixazo.ai) - abandoned: their API gateway blocks server-side
# requests with a Cloudflare bot challenge (403), unusable for backend integration.
PIXAZO_API_KEY=

# NVIDIA NIM (https://build.nvidia.com/qwen/qwen-image-edit) - experimental alternate
# image provider, Qwen-Image-Edit: real instruction-based editing (not img2img+
# strength), open-weight, comparable structure-preservation to closed-source models.
# Hosted via https://integrate.api.nvidia.com. Cloudflare remains default/primary.
NVIDIA_API_KEY=

# Storage backend: "local" (default, dev) or "s3" (Cloudflare R2 / AWS S3, S3-compatible)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/storage

# Only needed when STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# SQLite database file
DATABASE_URL=sqlite:///data/app.db
